ACME_EMAIL=admin@timecampus.asia

MYSQL_URL=jdbc:mysql://your-mysql-host:3306/timecampus?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=timecampus
MYSQL_PASSWORD=change-me

REDIS_DATABASE=1
REDIS_PASSWORD=

WECHAT_APPID=change-me
WECHAT_SECRET=change-me
TENCENT_MAP_KEY=change-me
TENCENT_MAP_SK=change-me

CAP_ENABLED=true
CAP_ADMIN_KEY=change-me-at-least-32-random-characters
CAP_CORS_ORIGIN=https://admin.timecampus.asia
CAP_SITEVERIFY_URL=https://cap.timecampus.asia/replace-with-site-key/siteverify
CAP_SECRET=replace-with-site-secret-from-cap-dashboard

TIMECAMPUS_MAX_FILE_SIZE_MB=10
TIMECAMPUS_MEDIA_FILE_TOKEN_TTL_SECONDS=600
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m
